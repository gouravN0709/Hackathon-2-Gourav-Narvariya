# Copy to .env.local for local development.
# Browser-safe: exposed to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never import in client code and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email confirmation gate (local stack: off)
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# Freeze "today" for demos/tests (omit to use the real current date)
NEXT_PUBLIC_TODAY=2026-10-15
